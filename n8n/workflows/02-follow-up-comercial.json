{
  "name": "02 · Follow-up Comercial (Diário)",
  "active": false,
  "tags": [{ "name": "crm-juridico" }, { "name": "comercial" }, { "name": "agendado" }],
  "settings": { "executionOrder": "v1", "saveManualExecutions": true },
  "nodes": [
    {
      "id": "a1b2c3d4-0002-0002-0002-000000000001",
      "name": "Agendamento Diário",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 9 * * 1-5" }]
        }
      },
      "notes": "Executa de segunda a sexta às 9h"
    },
    {
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Buscar Leads para Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CRM_BASE_URL }}/api/n8n/follow-up",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-n8n-api-key", "value": "={{ $env.N8N_INTERNAL_API_KEY }}" }]
        }
      }
    },
    {
      "id": "a1b2c3d4-0002-0002-0002-000000000003",
      "name": "Tem leads para follow-up?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.totais.follow_up + $json.totais.propostas_abertas }}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }]
        }
      }
    },
    {
      "id": "a1b2c3d4-0002-0002-0002-000000000004",
      "name": "Separar Follow-ups",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200],
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst todos = [\n  ...(data.follow_up ?? []).map(l => ({ ...l, tipo_acao: 'follow_up_agendado' })),\n  ...(data.propostas_abertas ?? []).map(l => ({ ...l, tipo_acao: 'proposta_sem_resposta' })),\n];\nreturn todos.map(l => ({ json: l }));"
      }
    },
    {
      "id": "a1b2c3d4-0002-0002-0002-000000000005",
      "name": "Aguardar 3s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1120, 200],
      "parameters": { "amount": 3, "unit": "seconds" },
      "notes": "Rate limiting: evitar throttle do WhatsApp"
    },
    {
      "id": "a1b2c3d4-0002-0002-0002-000000000006",
      "name": "Montar Mensagem WhatsApp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 200],
      "parameters": {
        "jsCode": "const l = $input.first().json;\nlet msg = '';\n\nif (l.tipo_acao === 'follow_up_agendado') {\n  msg = `Olá ${l.nome.split(' ')[0]}! 👋\\n\\nPassei aqui para dar continuidade ao seu atendimento no escritório.\\n\\nVocê tem alguma dúvida ou precisa de mais informações sobre seu caso?\\n\\nEstou à disposição! 😊`;\n} else if (l.tipo_acao === 'proposta_sem_resposta') {\n  msg = `Olá ${l.nome.split(' ')[0]}! \\n\\nEnviei uma proposta de honorários há alguns dias e gostaria de saber se você teve a oportunidade de analisá-la.\\n\\nPosso esclarecer qualquer dúvida! 📋`;\n}\n\nreturn [{ json: { ...l, mensagem: msg } }];"
      }
    },
    {
      "id": "a1b2c3d4-0002-0002-0002-000000000007",
      "name": "Enviar WhatsApp via ZapConnecta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1560, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ZAPCONNECTA_API_URL }}/send-message",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.ZAPCONNECTA_API_KEY }}" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ phone: $json.telefone, message: $json.mensagem, instance_id: $env.ZAPCONNECTA_INSTANCE_ID }) }}",
        "options": { "timeout": 10000 }
      }
    },
    {
      "id": "a1b2c3d4-0002-0002-0002-000000000008",
      "name": "Registrar Interação no CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1780, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_BASE_URL }}/api/trpc/interactions.create",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-n8n-api-key",  "value": "={{ $env.N8N_INTERNAL_API_KEY }}" },
            { "name": "Content-Type",    "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ json: { lead_id: $json.id, tipo: 'whatsapp', conteudo: 'Follow-up automático enviado via WhatsApp. Mensagem: ' + $json.mensagem, metadata: { automatico: true, tipo_acao: $json.tipo_acao, n8n_execution: $execution.id } } }) }}"
      }
    },
    {
      "id": "a1b2c3d4-0002-0002-0002-000000000009",
      "name": "Sem Follow-ups",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 420],
      "parameters": {}
    }
  ],
  "connections": {
    "Agendamento Diário":         { "main": [[{ "node": "Buscar Leads para Follow-up", "type": "main", "index": 0 }]] },
    "Buscar Leads para Follow-up": { "main": [[{ "node": "Tem leads para follow-up?", "type": "main", "index": 0 }]] },
    "Tem leads para follow-up?":  {
      "main": [
        [{ "node": "Separar Follow-ups", "type": "main", "index": 0 }],
        [{ "node": "Sem Follow-ups",     "type": "main", "index": 0 }]
      ]
    },
    "Separar Follow-ups":         { "main": [[{ "node": "Aguardar 3s", "type": "main", "index": 0 }]] },
    "Aguardar 3s":                { "main": [[{ "node": "Montar Mensagem WhatsApp", "type": "main", "index": 0 }]] },
    "Montar Mensagem WhatsApp":   { "main": [[{ "node": "Enviar WhatsApp via ZapConnecta", "type": "main", "index": 0 }]] },
    "Enviar WhatsApp via ZapConnecta": { "main": [[{ "node": "Registrar Interação no CRM", "type": "main", "index": 0 }]] }
  }
}
