# =============================================================================
# CRM JURÍDICO — Variáveis de Ambiente
# Copie este arquivo para .env.local (desenvolvimento) ou configure no EasyPanel
# NUNCA commitar o arquivo .env.local com valores reais
# =============================================================================

# ─── Supabase ─────────────────────────────────────────────────���───────────────
# URL pública do projeto Supabase (segura para expor no browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Chave anon — usada no browser (respeita RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key — NUNCA expor ao browser, apenas server-side (bypassa RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── App ──────────────────────────────────────────────────────────────────────
# URL base da aplicação (sem barra no final)
NEXT_PUBLIC_APP_URL=https://crm.seuescritorio.com.br

# Node environment
NODE_ENV=production

# ─── ZapSign ──────────────────────────────────────────────────────────────────
# Painel ZapSign → Configurações → Integrações → API Token
ZAPSIGN_API_TOKEN=zs-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Configurado em: ZapSign → Webhooks → Segredo HMAC
ZAPSIGN_WEBHOOK_SECRET=seu_segredo_hmac_aqui

# ID do template de contrato padrão (opcional — se usar templates)
# ZAPSIGN_TEMPLATE_ID=abc123

# ─── Asaas ────────────────────────────────────────────────────────────────────
# Painel Asaas → Minha Conta → Integrações → Gerar token
ASAAS_API_KEY=$aas_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# production | sandbox
ASAAS_ENVIRONMENT=production

# Configurado em: Asaas → Configurações → Webhooks → Token de acesso
ASAAS_WEBHOOK_TOKEN=seu_token_webhook_asaas

# ID da conta/carteira (disponível no painel Asaas)
# ASAAS_WALLET_ID=xxxxxxxx

# ─── Cal.com ──────────────────────────────────────────────────────────────────
# Painel Cal.com → Settings → Developer → API Keys
CALCOM_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID do tipo de evento padrão para reuniões (Settings → Event Types)
CALCOM_EVENT_TYPE_ID=123456

# Configurado em: Cal.com → Settings → Developer → Webhooks → Secret
CALCOM_WEBHOOK_SECRET=seu_segredo_calcom_aqui

# ─── n8n ──────────────────────────────────────────────────────────────────────
# URL base do servidor n8n (sem barra)
N8N_BASE_URL=https://n8n.seudominio.com.br

# Chave de API para autenticar chamadas internas entre CRM e n8n
# Gere um valor seguro: openssl rand -hex 32
N8N_INTERNAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook URLs do n8n (configuradas ao ativar cada workflow)
# Estas são chamadas pelo CRM para acionar automações no n8n
N8N_WEBHOOK_ENVIO_CONTRATO=https://n8n.seudominio.com.br/webhook/envio-contrato
N8N_WEBHOOK_CRIAR_COBRANCA=https://n8n.seudominio.com.br/webhook/criar-cobranca
N8N_WEBHOOK_ONBOARDING=https://n8n.seudominio.com.br/webhook/onboarding-iniciado
N8N_WEBHOOK_ASTREA=https://n8n.seudominio.com.br/webhook/astrea-processo

# ─── ZapConnecta / Helena CRM ─────────────────────────────────────────────────
# URL base da API do ZapConnecta
ZAPCONNECTA_API_URL=https://api.zapconnecta.com.br/v1

# Chave de API do ZapConnecta (ou Helena)
ZAPCONNECTA_API_KEY=seu_token_zapconnecta

# ID da instância WhatsApp conectada
ZAPCONNECTA_INSTANCE_ID=sua_instancia_id

# Segredo para validar webhooks recebidos do ZapConnecta
WEBHOOK_SECRET_LEAD_ENTRADA=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Astrea ───────────────────────────────────────────────────────────────────
# Token de API do Astrea
ASTREA_API_TOKEN=seu_token_astrea_aqui

# URL base da API (padrão abaixo; alterar se for instância self-hosted)
ASTREA_BASE_URL=https://api.astrea.net.br/v1

# ─── E-mail (SMTP) ────────────────────────────────��───────────────────────────
# Configurações de e-mail para o n8n enviar relatórios
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua_senha_de_app_gmail
SMTP_FROM_EMAIL=CRM Jurídico <noreply@seuescritorio.com.br>

# Destinatários do relatório semanal (separados por vírgula)
RELATORIO_DESTINATARIOS=socio@escritorio.com.br,gerente@escritorio.com.br

# ─── Notificações Admin ───────────────────────────────────────────────────────
# Número WhatsApp do admin para receber relatório semanal (código país + DDD + número)
ADMIN_WHATSAPP_NUMBER=5511999999999

# ─── Segurança ────────────────────────────────────────────────────────────────
# Segredo para NEXTAUTH / JWT (se necessário no futuro)
# NEXTAUTH_SECRET=

# Chave de criptografia de configurações de integração (AES-256)
# Gere com: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
