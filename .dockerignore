# =============================================================================
# .dockerignore — CRM Jurídico
# Exclui arquivos que não devem entrar na imagem Docker
# =============================================================================

# Dependências (reinstaladas no build)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build anterior
.next
out
dist
build

# Variáveis de ambiente — NUNCA incluir no build
.env
.env.*
!.env.example

# Git
.git
.gitignore
.gitattributes

# Documentação e configs de dev
*.md
DEPLOY.md
.vscode
.idea
.editorconfig

# Testes
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage
playwright-report
test-results

# Supabase CLI (usado apenas em dev)
supabase/.branches
supabase/.temp

# n8n workflows (não precisam estar na imagem da app)
n8n

# CI/CD
.github

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Misc
.DS_Store
Thumbs.db
*.log
*.pid
.turbo
.vercel
